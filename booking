    <!-- Lead Tracking -->
    <script type="text/javascript">
        (function () {
            const urlParams = new URLSearchParams(window.location.search);
            const urlCid = urlParams.get('cid');
            const urlPhone = urlParams.get('phone');

            if (urlCid) localStorage.setItem('lead_track_cid', urlCid);
            if (urlPhone) localStorage.setItem('lead_track_phone', urlPhone);

            const leadId = urlCid || localStorage.getItem('lead_track_cid');
            const phone = urlPhone || localStorage.getItem('lead_track_phone');

            // Log visits to GA
            if (leadId) {
                gtag('event', 'ai_lead_page_visit', {
                    'event_category': 'booking',
                    'event_label': leadId,
                    'conversation_id': leadId,
                    'phone': phone
                });
                console.log('AI Lead recognized:', leadId);
            }

            // Decorate booking links
            const decorateLinks = () => {
                if (leadId) {
                    document.querySelectorAll('a[href*="squareup.com"], a[href="/booking"]').forEach(link => {
                        try {
                            const url = new URL(link.href, window.location.origin);
                            if (!url.searchParams.has('cid') && !url.searchParams.has('conversation_id')) {
                                url.searchParams.set('cid', leadId);
                                if (phone) url.searchParams.set('phone', phone);
                                link.href = url.toString();
                            }
                        } catch (e) { }
                    });
                }
            };

            window.addEventListener('load', decorateLinks);
            setInterval(decorateLinks, 2000);
        })();
    </script>

