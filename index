    <script>
        (() => {
            const rows = Array.from(document.querySelectorAll('[data-carousel-row="reviews"]'));
            if (rows.length === 0) {
                return;
            }

            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
            let isPaused = prefersReducedMotion.matches;
            let activeRow = null;
            let startX = 0;
            let startScrollLeft = 0;
            let lastTime = null;
            let resumeTimeout;
            const rowStates = new Map();
            const speed = 32;

            const wrapOffset = (state) => {
                if (!state || state.resetPoint <= 0) {
                    return;
                }
                if (state.offset >= state.resetPoint) {
                    state.offset -= state.resetPoint;
                } else if (state.offset < 0) {
                    state.offset += state.resetPoint;
                }
            };

            const setupRow = (row) => {
                const track = row.querySelector('.reviews__track');
                if (!track) {
                    return;
                }
                if (!track.dataset.cloned) {
                    const cards = Array.from(track.children);
                    cards.forEach((card) => {
                        const clone = card.cloneNode(true);
                        clone.setAttribute('aria-hidden', 'true');
                        track.appendChild(clone);
                    });
                    track.dataset.cloned = 'true';
                }
                const direction = row.dataset.direction === 'left' ? -1 : 1;
                const state = {
                    track,
                    direction,
                    resetPoint: track.scrollWidth / 2,
                    offset: 0
                };
                if (direction === -1) {
                    state.offset = state.resetPoint;
                    row.scrollLeft = state.offset;
                } else {
                    state.offset = row.scrollLeft;
                }
                rowStates.set(row, state);
            };

            rows.forEach(setupRow);

            const updateResetPoints = () => {
                rowStates.forEach((state, row) => {
                    state.resetPoint = state.track.scrollWidth / 2;
                    state.offset = row.scrollLeft;
                    wrapOffset(state);
                    row.scrollLeft = state.offset;
                });
            };

            const tick = (time) => {
                if (lastTime === null) {
                    lastTime = time;
                }
                const delta = time - lastTime;
                if (!isPaused) {
                    rowStates.forEach((state, row) => {
                        if (state.resetPoint <= row.clientWidth) {
                            return;
                        }
                        state.offset += (speed * delta) / 1000 * state.direction;
                        wrapOffset(state);
                        row.scrollLeft = state.offset;
                    });
                }
                lastTime = time;
                window.requestAnimationFrame(tick);
            };

            const pauseAuto = () => {
                isPaused = true;
                if (resumeTimeout) {
                    window.clearTimeout(resumeTimeout);
                }
            };

            const resumeAuto = () => {
                if (prefersReducedMotion.matches) {
                    return;
                }
                isPaused = false;
                lastTime = null;
            };

            const handlePointerDown = (event) => {
                if (event.target.closest('a')) {
                    return;
                }
                pauseAuto();
                activeRow = event.currentTarget;
                startX = event.clientX;
                startScrollLeft = activeRow.scrollLeft;
                const state = rowStates.get(activeRow);
                if (state) {
                    state.offset = startScrollLeft;
                }
                activeRow.classList.add('is-dragging');
                activeRow.setPointerCapture(event.pointerId);
            };

            const handlePointerMove = (event) => {
                if (!activeRow) {
                    return;
                }
                const state = rowStates.get(activeRow);
                if (!state) {
                    return;
                }
                const delta = event.clientX - startX;
                state.offset = startScrollLeft - delta;
                wrapOffset(state);
                activeRow.scrollLeft = state.offset;
            };

            const handlePointerUp = (event) => {
                if (!activeRow) {
                    return;
                }
                activeRow.classList.remove('is-dragging');
                const state = rowStates.get(activeRow);
                if (state) {
                    state.offset = activeRow.scrollLeft;
                }
                try {
                    activeRow.releasePointerCapture(event.pointerId);
                } catch (err) {
                    // no-op
                }
                activeRow = null;
                resumeTimeout = window.setTimeout(resumeAuto, 500);
            };

            const handleWheel = (event) => {
                pauseAuto();
                const state = rowStates.get(event.currentTarget);
                if (state) {
                    state.offset = event.currentTarget.scrollLeft;
                }
                resumeTimeout = window.setTimeout(resumeAuto, 700);
            };

            rows.forEach((row) => {
                row.addEventListener('pointerdown', handlePointerDown);
                row.addEventListener('pointermove', handlePointerMove);
                row.addEventListener('pointerup', handlePointerUp);
                row.addEventListener('pointercancel', handlePointerUp);
                row.addEventListener('pointerleave', handlePointerUp);
                row.addEventListener('wheel', handleWheel, { passive: true });
            });
            window.addEventListener('resize', updateResetPoints);

            window.requestAnimationFrame(tick);
        })();
    </script>

    <!-- Quote Draft Handler -->
    <script type="text/javascript">
        (function () {
            const form = document.getElementById('contact-form');
            const submitBtn = document.getElementById('submit-btn');
            const formStatus = document.getElementById('form-status');
            const modal = document.getElementById('quote-preview-modal');
            const preview = document.getElementById('quote-preview-text');
            const textLink = document.getElementById('quote-text-link');
            const emailLink = document.getElementById('quote-email-link');
            const copyBtn = document.getElementById('quote-copy-btn');
            const copyStatus = document.getElementById('quote-copy-status');

            if (!form || !modal || !preview || !textLink || !emailLink || !copyBtn) return;

            let currentDraft = '';

            const trackQuoteEvent = (eventName, extra = {}) => {
                if (window.obsidianLeadTracking?.trackEvent) {
                    window.obsidianLeadTracking.trackEvent(eventName, extra);
                    return;
                }

                if (typeof window.gtag === 'function') {
                    window.gtag('event', eventName, {
                        event_category: 'quote_draft',
                        ...extra
                    });
                }
            };

            const openModal = () => {
                modal.hidden = false;
                document.body.classList.add('quote-modal-open');
                copyStatus.textContent = '';
                textLink.focus();
            };

            const closeModal = () => {
                modal.hidden = true;
                document.body.classList.remove('quote-modal-open');
                submitBtn.focus();
            };

            const buildDraft = (formData) => {
                const name = (formData.get('name') || '').trim();
                const phone = (formData.get('phone') || '').trim();
                const email = (formData.get('email') || '').trim();
                const vehicle = (formData.get('vehicle') || '').trim();
                const service = (formData.get('service') || '').trim();
                const details = (formData.get('details') || '').trim();

                return {
                    name,
                    phone,
                    email,
                    vehicle,
                    service,
                    details,
                    message: [
                        `Hi Obsidian, this is ${name || 'a new customer'}.`,
                        `I want a quote for ${service || 'window tinting'} on my ${vehicle || 'vehicle'}.`,
                        `My phone number is ${phone || 'not provided'}${email ? ` and my email is ${email}` : ''}.`,
                        details ? `Notes: ${details}` : '',
                        'Can you confirm pricing and the best appointment time?'
                    ].filter(Boolean).join('\n')
                };
            };

            form.addEventListener('submit', function (event) {
                event.preventDefault();
                if (!form.reportValidity()) return;

                const draft = buildDraft(new FormData(form));
                currentDraft = draft.message;
                preview.textContent = currentDraft;

                const encodedBody = encodeURIComponent(currentDraft);
                textLink.href = `sms:+17146007134?&body=${encodedBody}`;
                emailLink.href = `mailto:obsidianautoworksoc@gmail.com?subject=${encodeURIComponent('Window Tint Quote Request')}&body=${encodedBody}`;

                formStatus.textContent = 'Review the draft, then text, email, or copy it.';
                formStatus.className = 'form-status form-status--success';
                openModal();

                trackQuoteEvent('quote_draft_created', {
                    service: draft.service,
                    vehicle: draft.vehicle
                });
            });

            textLink.addEventListener('click', () => trackQuoteEvent('quote_text_click'));
            emailLink.addEventListener('click', () => trackQuoteEvent('quote_email_click'));

            copyBtn.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(currentDraft);
                    copyStatus.textContent = 'Copied.';
                    trackQuoteEvent('quote_copy_click');
                } catch (error) {
                    copyStatus.textContent = 'Copy failed. Select the draft text and copy it manually.';
                }
            });

            modal.querySelectorAll('[data-quote-close]').forEach((button) => {
                button.addEventListener('click', closeModal);
            });

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && !modal.hidden) closeModal();
            });
        })();
    </script>
    <script src="/lead-tracking.js" defer></script>
