    <script>
        (function () {
            const form = document.querySelector('[data-residential-consultation-form]');
            if (!form) return;

            const status = document.querySelector('[data-residential-consultation-status]');
            const submitButton = form.querySelector('button[type="submit"]');
            let started = false;

            const startConsultation = () => {
                if (started || !window.obsidianLeadTracking) return;
                started = true;
                window.obsidianLeadTracking.trackEvent('residential_consultation_start', {
                    page_type: 'residential_window_film'
                });
            };

            const fieldValue = (formData, name) => (formData.get(name) || '').toString().trim();

            form.addEventListener('focusin', startConsultation, { once: true });
            document.querySelectorAll('[data-residential-cta]').forEach((link) => {
                link.addEventListener('click', () => {
                    startConsultation();
                    if (window.obsidianLeadTracking) {
                        window.obsidianLeadTracking.trackEvent('residential_cta_click', {
                            page_type: 'residential_window_film',
                            cta_id: link.getAttribute('data-residential-cta'),
                            link_url: link.href,
                            link_text: (link.textContent || '').trim()
                        });
                    }
                });
            });

            form.addEventListener('submit', async (event) => {
                event.preventDefault();
                startConsultation();
                if (!form.checkValidity()) {
                    form.reportValidity();
                    return;
                }
                if (!window.obsidianLeadTracking || typeof window.obsidianLeadTracking.submitLeadEvent !== 'function') {
                    status.textContent = 'We could not send your request. Please call to schedule a visit.';
                    return;
                }

                const formData = new FormData(form);
                const payload = {
                    consultation_name: fieldValue(formData, 'consultation_name'),
                    consultation_phone: fieldValue(formData, 'consultation_phone'),
                    consultation_city_zip: fieldValue(formData, 'consultation_city_zip'),
                    consultation_decision_maker: fieldValue(formData, 'consultation_decision_maker'),
                    consultation_property_type: fieldValue(formData, 'consultation_property_type'),
                    consultation_project_size: fieldValue(formData, 'consultation_project_size'),
                    consultation_goal: fieldValue(formData, 'consultation_goal'),
                    consultation_preferred_date: fieldValue(formData, 'consultation_preferred_date'),
                    consultation_preferred_time: fieldValue(formData, 'consultation_preferred_time'),
                    consultation_pricing_acknowledgement: fieldValue(formData, 'consultation_pricing_acknowledgement')
                };

                submitButton.disabled = true;
                status.textContent = 'Sending your consultation request...';
                const result = await window.obsidianLeadTracking.submitLeadEvent('residential_consultation_request', payload, {
                    lead: { phone: payload.consultation_phone },
                    analyticsPayload: {
                        page_type: 'residential_window_film',
                        consultation_property_type: payload.consultation_property_type,
                        consultation_project_size: payload.consultation_project_size,
                        consultation_goal: payload.consultation_goal,
                        consultation_preferred_time: payload.consultation_preferred_time
                    }
                });

                if (result.ok) {
                    status.textContent = 'Request received. We will follow up to confirm your on-site consultation.';
                    form.reset();
                } else {
                    status.textContent = 'We could not send your request. Please call to schedule a visit.';
                    submitButton.disabled = false;
                }
            });
        })();
    </script>
    <script src="/lead-tracking.js" defer></script>
</body>

</html>
