    <script>
        (function () {
            const phone = '7146007134';
            const state = {
                problem: '',
                glass: '',
                property: ''
            };
            const steps = [
                {
                    key: 'problem',
                    eyebrow: 'Start with the problem',
                    question: 'What should the film accomplish first?',
                    options: [
                        ['Heat', 'Rooms get too hot when the sun hits the glass'],
                        ['Glare', 'TV, monitor, or living spaces are too bright'],
                        ['Privacy', 'Street-facing, customer-facing, or neighbor-facing windows'],
                        ['Security', 'Added glass retention or safety is the priority'],
                        ['Decorative', 'A frosted, branded, or design-forward finish'],
                        ['UV protection', 'Furniture, floors, products, or artwork get too much sun'],
                        ['Not sure', 'You want Kislev to recommend the right path']
                    ]
                },
                {
                    key: 'glass',
                    eyebrow: 'Scope the property',
                    question: 'What kind of property or glass are we looking at?',
                    options: [
                        ['Home', 'One room, several rooms, or a whole-home project'],
                        ['Storefront', 'Customer-facing glass, doors, or display windows'],
                        ['Office / commercial', 'Interior or exterior glass at a business property'],
                        ['Large panes / sliders', 'Patio doors, view glass, or oversized windows'],
                        ['Custom / not sure', 'Specialty glass, high access, mixed goals, or unknown construction']
                    ]
                },
                {
                    key: 'property',
                    eyebrow: 'Estimate path',
                    question: 'How would you like to start?',
                    options: [
                        ['Free consultation', 'See free film samples in your space and keep your favorites'],
                        ['Send project details', 'Best if you have measurements, photos, window count, and glass information'],
                        ['Need measurement help', 'Start with a consultation before trying to estimate the scope'],
                        ['Not ready yet', 'Save the setup and ask questions first']
                    ]
                }
            ];

            let stepIndex = 0;
            const root = document.querySelector('[data-residential-diagnostic]');
            if (!root) return;

            const body = root.querySelector('[data-res-body]');
            const count = root.querySelector('[data-res-count]');
            const bar = root.querySelector('[data-res-bar]');
            const summaryTitle = root.querySelector('[data-res-summary-title]');
            const summaryProblem = root.querySelector('[data-res-summary-problem]');
            const summaryGlass = root.querySelector('[data-res-summary-glass]');
            const summaryProperty = root.querySelector('[data-res-summary-property]');

            const track = (eventName, payload) => {
                if (window.obsidianLeadTracking && typeof window.obsidianLeadTracking.trackEvent === 'function') {
                    window.obsidianLeadTracking.trackEvent(eventName, {
                        page_type: 'residential_window_film',
                        residential_problem: state.problem,
                        residential_glass: state.glass,
                        residential_property: state.property,
                        ...payload
                    });
                }
            };

            const updateSummary = () => {
                summaryProblem.textContent = state.problem || 'Not selected yet';
                summaryGlass.textContent = state.glass || 'Not selected yet';
                summaryProperty.textContent = state.property || 'Not selected yet';
                if (state.problem || state.glass || state.property) {
                    summaryTitle.textContent = 'Good. Book a consultation or send the project details.';
                }
            };

            const buildTextHref = () => {
                const lines = [
                    'Hi Obsidian Autoworks, I am looking for residential or commercial window film.',
                    state.problem ? `Project goal: ${state.problem}` : '',
                    state.glass ? `Property/glass scope: ${state.glass}` : '',
                    state.property ? `Preferred next step: ${state.property}` : '',
                    'For a rough estimate, I can send measurements, photos, window count, and any glass type or coating details I have.'
                ].filter(Boolean);
                return `sms:${phone}?&body=${encodeURIComponent(lines.join('\n'))}`;
            };

            const renderFinish = () => {
                count.textContent = 'Ready';
                bar.style.width = '100%';
                body.innerHTML = `
                    <div class="res-diagnostic__hint">Recommended next step</div>
                    <h3>See samples or send the project details.</h3>
                    <p class="res-fineprint" style="color: rgba(255,255,255,0.72); margin: 0 0 1.35rem;">
                        A rough estimate comes after we review measurements, photos, window count, glass details, and your goal. Book a free consultation if you want to see and keep film samples first.
                    </p>
                    <div class="res-cta-row">
                        <a href="tel:7146007134" class="brutalist-btn brutalist-btn--primary" data-res-final-call>Book Free Consultation</a>
                        <a href="${buildTextHref()}" class="brutalist-btn" data-res-final-text>Send Project Details</a>
                    </div>
                    <div class="res-diagnostic__actions">
                        <button class="res-back" type="button" data-res-restart>Start Over</button>
                    </div>
                `;
                track('residential_quiz_finish', {});
                body.querySelector('[data-res-final-call]').addEventListener('click', () => {
                    track('residential_quiz_call_click', { link_url: `tel:${phone}` });
                });
                body.querySelector('[data-res-final-text]').addEventListener('click', () => {
                    track('residential_quiz_text_click', { link_url: buildTextHref() });
                });
                body.querySelector('[data-res-restart]').addEventListener('click', () => {
                    state.problem = '';
                    state.glass = '';
                    state.property = '';
                    stepIndex = 0;
                    track('residential_quiz_restart_click', {});
                    updateSummary();
                    renderStep();
                });
            };

            const renderStep = () => {
                const step = steps[stepIndex];
                count.textContent = `Step ${stepIndex + 1} / ${steps.length}`;
                bar.style.width = `${((stepIndex + 1) / steps.length) * 100}%`;
                body.innerHTML = `
                    <div class="res-diagnostic__hint">${step.eyebrow}</div>
                    <h3>${step.question}</h3>
                    <div class="res-option-grid"></div>
                    <div class="res-diagnostic__actions">
                        ${stepIndex > 0 ? '<button class="res-back" type="button" data-res-back>Back</button>' : ''}
                    </div>
                `;

                const optionGrid = body.querySelector('.res-option-grid');
                step.options.forEach(([label, copy]) => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'res-option';
                    button.innerHTML = `<strong>${label}</strong><span>${copy}</span>`;
                    button.addEventListener('click', () => {
                        state[step.key] = label;
                        track('residential_quiz_answer', {
                            quiz_step: step.key,
                            quiz_answer: label
                        });
                        updateSummary();
                        if (stepIndex === steps.length - 1) {
                            renderFinish();
                        } else {
                            stepIndex += 1;
                            track('residential_quiz_step_advance', {
                                next_step: steps[stepIndex].key
                            });
                            renderStep();
                        }
                    });
                    optionGrid.appendChild(button);
                });

                const back = body.querySelector('[data-res-back]');
                if (back) {
                    back.addEventListener('click', () => {
                        stepIndex = Math.max(0, stepIndex - 1);
                        track('residential_quiz_back_click', {
                            next_step: steps[stepIndex].key
                        });
                        renderStep();
                    });
                }
            };

            document.querySelectorAll('[data-residential-cta]').forEach((link) => {
                link.addEventListener('click', () => {
                    track('residential_cta_click', {
                        cta_id: link.getAttribute('data-residential-cta'),
                        link_url: link.href,
                        link_text: (link.textContent || '').trim()
                    });
                });
            });

            renderStep();
            updateSummary();
        })();
    </script>
    <script src="/lead-tracking.js" defer></script>
</body>

</html>
