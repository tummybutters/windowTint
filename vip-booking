                    }
                },
                teslaModel: {
                    id: 'teslaModel',
                    total: 4,
                    question: 'Which Tesla model?',
                    hint: 'Tesla glass packages price a little differently.',
                    options: [
                        { label: 'Model 3', copy: 'Full car or sides and rear', value: '3' },
                        { label: 'Model S', copy: 'Full, sides and rear, or pano roof', value: 's' },
