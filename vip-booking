                },
                coverage: {
                    id: 'coverage',
                    total: 4,
                    question: 'What coverage do you want?',
                    hint: 'Pick the main service first. Add-ons come next.',
                    options() {
                        if (state.vehicle === 'tesla') {
                            const options = [
                                { label: 'Full car', copy: 'Maximum heat rejection and complete look', value: 'full' },
                                { label: 'Sides & rear', copy: 'Core cabin coverage', value: 'sides' }
                            ];
                            if (state.teslaModel === 's' || state.teslaModel === 'y') {
                                options.push({ label: 'Panoramic roof', copy: 'Roof-only Tesla add-on', value: 'roof' });
                            }
                            options.push({ label: 'Not sure', copy: 'Let Kislev confirm the best package', value: 'custom' });
                            return options;
                        }

                        return [
                            { label: 'Full car', copy: 'Windshield, side, and rear glass', value: 'full' },
                            { label: 'Sides & rear', copy: 'Side windows plus rear glass', value: 'sides' },
                            { label: 'Front 2 windows', copy: 'Driver and passenger windows', value: 'front' },
                            { label: 'Windshield only', copy: 'Heat and glare protection up front', value: 'windshield' },
                            { label: 'Single window', copy: 'One window replacement or correction', value: 'single' },
                            { label: 'Roof / sunroof', copy: 'Sunroof or panoramic glass', value: 'roof' }
                        ];
                    },
                    next(value) {
                        state.coverage = value;
                        if (value === 'custom' || value === 'roof') return 'result';
                        return 'addons';
                    }
                },
                addons: {
                    id: 'addons',
                    total: 4,
                    question: 'Anything else with it?',
                    hint: 'Optional. These help us tee up the appointment correctly.',
                    multi: true,
                    options: [
                        { label: 'Windshield sunstrip', copy: '$60 fixed add-on', value: 'sunstrip' },
                        { label: 'Sunroof / pano roof', copy: 'Add roof glass if needed', value: 'roof' },
                        { label: 'Old tint removal', copy: 'Usually needs confirmation', value: 'removal' },
                        { label: 'Mobile / same-day priority', copy: 'Confirm availability first', value: 'priority' },
                        { label: 'No add-ons', copy: 'Just the main package', value: 'none' }
                    ],
                    next(value) {
                        if (value === 'none') {
                            state.addons = [];
                            return 'result';
                        }

                        if (state.addons.includes(value)) {
                            state.addons = state.addons.filter((addon) => addon !== value);
                        } else {
                            state.addons = state.addons.filter((addon) => addon !== 'none').concat(value);
                        }
                        return 'addons';
                    }
                }
            };

            const getStepIndex = (stepId) => {
                if (stepId === 'vehicle') return 1;
                if (stepId === 'teslaModel') return 2;
                if (stepId === 'coverage') return state.vehicle === 'tesla' ? 3 : 2;
                if (stepId === 'addons') return state.vehicle === 'tesla' ? 4 : 3;
                return 4;
            };

            const resolveService = () => {
                if (state.vehicle === 'architectural') return services.quote_architectural;
                if (state.vehicle === 'custom') return services.quote_auto;
                if (state.coverage === 'custom') return services.quote_auto;

                if (state.vehicle === 'tesla') {
                    const key = `tesla${state.teslaModel}_${state.coverage}`;
                    return services[key] || services.quote_auto;
                }

                if (state.coverage === 'full') return services[`${state.vehicle}_full`] || services.quote_auto;
                if (state.coverage === 'sides') return services[`${state.vehicle}_sides`] || services.quote_auto;
                if (state.coverage === 'front') return state.vehicle === 'truck' ? services.front_truck : services.front_sedan;
                if (state.coverage === 'windshield') return state.vehicle === 'truck' ? services.windshield_truck : services.windshield_sedan;
                if (state.coverage === 'single') return services.single_window;
                if (state.coverage === 'roof') return services.panoramic;

                return services.quote_auto;
            };

            const getAddonLabels = () => {
                const labels = {
                    sunstrip: 'Windshield sunstrip',
                    roof: 'Sunroof / panoramic roof',
                    removal: 'Old tint removal',
                    priority: 'Mobile / same-day priority'
                };
                return state.addons.map((addon) => labels[addon]).filter(Boolean);
            };

            const hasVariableAddon = () => state.addons.some((addon) => addon === 'removal' || addon === 'priority');

            const track = (eventName, payload = {}) => {
                if (window.obsidianLeadTracking && typeof window.obsidianLeadTracking.trackEvent === 'function') {
                    window.obsidianLeadTracking.trackEvent(eventName, payload);
                } else if (typeof window.gtag === 'function') {
                    window.gtag('event', eventName, {
                        event_category: 'vip_booking_quiz',
                        page_path: window.location.pathname,
                        ...payload
                    });
                }
            };

            const getQuizPayload = (service = null) => ({
                vehicle: state.vehicle,
                tesla_model: state.teslaModel,
                coverage: state.coverage,
                addons: state.addons.join(','),
                addon_labels: getAddonLabels().join(', '),
                service_title: service ? service.title : '',
                service_price: service ? service.price : '',
                service_duration: service ? service.duration : '',
                service_mode: service ? service.mode : '',
                square_booking_url: service && service.bookingUrl && squareBookingEnabled ? service.bookingUrl : '',
                square_booking_available: squareBookingEnabled ? 'yes' : 'no'
            });

            const buildTextHref = (service) => {
                const addons = getAddonLabels();
                const message = [
                    `Hi Obsidian Autoworks, I just used the VIP booking helper.`,
                    `Recommended service: ${service.title}.`,
                    `Price/time shown: ${service.price}, ${service.duration}.`,
                    addons.length ? `Add-ons: ${addons.join(', ')}.` : 'Add-ons: none.',
                    'Can you confirm this is the right setup?'
                ].join(' ');
                return `sms:${smsNumber}?body=${encodeURIComponent(message)}`;
            };

            const maybeDecorateLinks = () => {
                if (window.obsidianLeadTracking && typeof window.obsidianLeadTracking.decorateBookingTargets === 'function') {
                    window.obsidianLeadTracking.decorateBookingTargets();
                }
            };

            const typeText = (element, text, callback) => {
                if (reducedMotion) {
                    element.textContent = text;
                    callback();
                    return;
                }

                element.textContent = '';
                let index = 0;
                const tick = () => {
                    element.textContent = text.slice(0, index);
                    index += 1;
                    if (index <= text.length) {
                        window.setTimeout(tick, 20);
                    } else {
                        callback();
                    }
                };
                tick();
            };

            const render = (stepId) => {
                const current = steps[stepId];
                if (!current) {
                    renderResult();
                    return;
                }

                const stepIndex = getStepIndex(stepId);
                const options = typeof current.options === 'function' ? current.options() : current.options;
                count.textContent = `Step ${stepIndex} / ${current.total}`;
                bar.style.width = `${Math.max(20, (stepIndex / current.total) * 100)}%`;

