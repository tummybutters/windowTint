            background: linear-gradient(145deg, var(--gray-900) 0%, var(--gray-800) 100%);
            text-align: center;
        }

        .vip-hero .tag {
            display: inline-block;
            background: var(--sunset-glow);
            color: var(--black);
            padding: 0.5rem 1rem;
            font-weight: 700;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            border: 2px solid var(--black);
            box-shadow: 3px 3px 0 var(--black);
            margin-bottom: 1rem;
        }

        .vip-hero h1 {
            font-size: clamp(2.5rem, 8vw, 4.5rem);
            margin-bottom: 1rem;
            line-height: 0.9;
            text-transform: uppercase;
        }

        .vip-hero h1 span {
            background: var(--silver-shine);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: block;
        }

        /* Review Collage Grid */
        .collage-container {
            max-width: 1400px;
            margin: 0 auto 4rem;
            padding: 0 2rem;
        }

        .collage-grid {
            display: grid;
            grid-template-columns: repeat(12, minmax(0, 1fr));
            grid-auto-rows: clamp(190px, 22vw, 270px);
            gap: 6px;
            row-gap: 26px;
            padding: 1rem 0 2rem;
            overflow: visible;
        }

        .collage-item {
            position: relative;
            overflow: hidden;
            border: 4px solid var(--black);
            background: #111;
            box-shadow: var(--shadow-md);
            transition: transform 0.3s ease;
            transform-origin: bottom left;
            height: 100%;
            margin: -16px 0 0 -18px;
            cursor: pointer;
        }

        .collage-item:first-child {
            margin-left: 0;
        }

        .collage-item:hover {
            transform: translateY(-6px) rotate(0deg) scale(1.02);
            z-index: 10;
        }

        .collage-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.7;
            transition: opacity 0.3s;
        }

        .collage-item:hover img {
            opacity: 1;
        }

        .collage-review {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 1.5rem;
            background: linear-gradient(transparent, rgba(0, 0, 0, 0.92));
            color: var(--white);
        }

        .collage-review p {
            font-size: 0.85rem;
            font-weight: 500;
            line-height: 1.2;
            margin-bottom: 0.5rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .collage-review .reviewer {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--sunset-coral);
            font-weight: 700;
        }

        .collage-item.is-open .collage-review p,
        .collage-item:hover .collage-review p {
            -webkit-line-clamp: unset;
        }

        /* Poker-deck collage offsets */
        .collage-item:nth-child(1) { transform: rotate(-3deg) translateY(6px); z-index: 1; }
        .collage-item:nth-child(2) { transform: rotate(-1.5deg) translateY(3px); z-index: 2; }
        .collage-item:nth-child(3) { transform: rotate(1.5deg) translateY(2px); z-index: 3; }
        .collage-item:nth-child(4) { transform: rotate(3deg) translateY(6px); z-index: 4; }
        .collage-item:nth-child(5) { transform: rotate(-3deg) translateY(-6px); z-index: 1; }
        .collage-item:nth-child(6) { transform: rotate(-1deg) translateY(-8px); z-index: 2; }
        .collage-item:nth-child(7) { transform: rotate(2deg) translateY(-6px); z-index: 3; }

        .collage-item:nth-child(1) { grid-column: 1 / span 3; }
        .collage-item:nth-child(2) { grid-column: 4 / span 3; }
        .collage-item:nth-child(3) { grid-column: 7 / span 3; }
        .collage-item:nth-child(4) { grid-column: 10 / span 3; }
        .collage-item:nth-child(5) { grid-column: 3 / span 3; }
        .collage-item:nth-child(6) { grid-column: 6 / span 3; }
        .collage-item:nth-child(7) { grid-column: 9 / span 3; }

        .vip-booking-section {
            background: linear-gradient(145deg, var(--gray-800) 0%, var(--gray-900) 100%);
            color: var(--white);
            padding: 5rem 0;
            border-top: 4px solid var(--black);
            scroll-margin-top: 6.5rem;
        }

        .vip-booking-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .vip-booking-header h2 {
            font-size: clamp(2.2rem, 5vw, 3rem);
            margin-bottom: 1rem;
            text-transform: uppercase;
        }

        .vip-booking-header h2 span {
            background: var(--silver-shine);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .trust-badges {
            display: flex;
            justify-content: center;
            gap: 2rem;
            margin-bottom: 3rem;
            flex-wrap: wrap;
        }

        .trust-badge {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.9rem;
            color: var(--text-light-gray);
        }

        .trust-badge span {
            color: var(--sunset-coral);
        }

        .booking-router {
            max-width: 980px;
            min-height: 560px;
            margin: 0 auto;
            border: 4px solid var(--black);
            background:
                linear-gradient(135deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0) 42%),
                linear-gradient(145deg, #111 0%, #050505 100%);
            box-shadow: 12px 12px 0 var(--black), 0 0 34px rgba(255, 107, 74, 0.16);
            overflow: hidden;
        }

        .booking-router__top {
            display: grid;
            grid-template-columns: 1fr auto;
            align-items: center;
            gap: 1rem;
            padding: 1.1rem 1.25rem;
            border-bottom: 3px solid var(--black);
            background: rgba(255, 255, 255, 0.05);
        }

        .booking-router__eyebrow,
        .booking-router__count,
        .booking-router__hint,
        .booking-router__meta,
        .booking-router__summary-label,
        .booking-router__fineprint {
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-weight: 700;
        }

        .booking-router__eyebrow {
            color: var(--sunset-coral);
            font-size: 0.78rem;
        }

        .booking-router__count {
            color: var(--text-light-gray);
            font-size: 0.75rem;
            white-space: nowrap;
        }

        .booking-router__progress {
            grid-column: 1 / -1;
            height: 6px;
            border: 2px solid var(--black);
            background: rgba(255, 255, 255, 0.12);
            overflow: hidden;
        }

        .booking-router__bar {
            display: block;
            width: 20%;
            height: 100%;
            background: var(--sunset-glow);
            transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .booking-router__body {
            min-height: 470px;
            padding: clamp(1.25rem, 4vw, 2.5rem);
            display: grid;
            align-content: center;
            gap: 1.5rem;
        }

        .booking-router__stage {
            display: grid;
            gap: 1.35rem;
            opacity: 1;
            transform: translateY(0);
            transition: opacity 0.34s ease, transform 0.34s ease;
        }

        .booking-router__stage.is-leaving {
            opacity: 0;
            transform: translateY(-14px);
        }

        .booking-router__stage.is-entering {
            opacity: 0;
            transform: translateY(18px);
        }

        .booking-router__hint {
            color: rgba(255, 255, 255, 0.58);
            font-size: 0.72rem;
        }

        .booking-router__question {
            min-height: 3.2em;
            font-size: clamp(2rem, 5vw, 3.6rem);
            line-height: 0.95;
            text-transform: uppercase;
            letter-spacing: 0;
        }

        .booking-router__cursor {
            display: inline-block;
            width: 0.08em;
            height: 0.9em;
            margin-left: 0.08em;
            background: var(--sunset-coral);
            vertical-align: -0.08em;
            animation: routerBlink 0.8s step-end infinite;
        }

        @keyframes routerBlink {
            50% { opacity: 0; }
        }

        .booking-router__options {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.85rem;
        }

        .booking-router__options:not(.is-ready) {
            pointer-events: none;
        }

        .booking-router__option {
            min-height: 92px;
            border: 3px solid var(--black);
            background: linear-gradient(145deg, #fff 0%, #e9e9e9 100%);
            color: var(--black);
            box-shadow: 5px 5px 0 var(--black);
            padding: 1rem;
            text-align: left;
            font-family: var(--font);
            cursor: pointer;
            transition: opacity 0.22s ease, transform 0.22s ease, box-shadow 0.18s ease, background 0.18s ease;
            opacity: 0;
            transform: translateY(12px);
        }

        .booking-router__options.is-ready .booking-router__option {
            opacity: 1;
            transform: translateY(0);
        }

        .booking-router__option:nth-child(2) { transition-delay: 0.04s; }
        .booking-router__option:nth-child(3) { transition-delay: 0.08s; }
        .booking-router__option:nth-child(4) { transition-delay: 0.12s; }
        .booking-router__option:nth-child(5) { transition-delay: 0.16s; }
        .booking-router__option:nth-child(6) { transition-delay: 0.2s; }

        .booking-router__option:hover,
        .booking-router__option.is-selected {
            background: var(--sunset-glow);
            transform: translate(-2px, -2px);
            box-shadow: 7px 7px 0 var(--black);
        }

        .booking-router__option-title {
            display: block;
            font-size: 1.05rem;
            font-weight: 900;
            line-height: 1.1;
            text-transform: uppercase;
        }

        .booking-router__option-copy {
            display: block;
            margin-top: 0.45rem;
            font-size: 0.82rem;
            font-weight: 600;
            line-height: 1.35;
            color: rgba(0, 0, 0, 0.72);
        }

        .booking-router__actions {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            align-items: center;
            flex-wrap: wrap;
        }

        .booking-router__back {
            border: 0;
            background: transparent;
            color: var(--text-light-gray);
            font-family: var(--font);
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            cursor: pointer;
            opacity: 0.8;
        }

        .booking-router__back:hover {
            opacity: 1;
            color: var(--white);
        }

        .booking-router__summary {
            display: grid;
            gap: 1rem;
        }

        .booking-router__summary-card {
            display: grid;
            gap: 1rem;
            border: 3px solid var(--black);
            background: linear-gradient(145deg, #fff 0%, #eeeeee 100%);
            color: var(--black);
            box-shadow: 8px 8px 0 var(--black);
            padding: clamp(1.25rem, 3vw, 2rem);
        }

        .booking-router__summary-label,
        .booking-router__meta {
            color: var(--sunset-coral);
            font-size: 0.76rem;
        }

        .booking-router__summary-title {
            font-size: clamp(1.8rem, 4vw, 2.8rem);
            line-height: 0.98;
            text-transform: uppercase;
        }

        .booking-router__price-row {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            align-items: center;
        }

        .booking-router__price {
            font-size: clamp(1.8rem, 5vw, 3rem);
            line-height: 1;
            font-weight: 900;
        }

        .booking-router__duration {
            border: 2px solid var(--black);
            padding: 0.35rem 0.6rem;
            font-weight: 900;
            text-transform: uppercase;
            background: rgba(255, 107, 74, 0.16);
        }

        .booking-router__notes {
            display: grid;
            gap: 0.45rem;
            color: rgba(0, 0, 0, 0.72);
            font-weight: 650;
        }

        .booking-router__cta-row {
            display: flex;
            gap: 0.85rem;
            flex-wrap: wrap;
        }

        .booking-router__fineprint {
            color: rgba(255, 255, 255, 0.68);
            font-size: 0.72rem;
            line-height: 1.6;
        }

        .booking-router__hidden {
            display: none;
        }

        @media (max-width: 900px) {
            .collage-grid {
                grid-auto-rows: clamp(160px, 26vw, 230px);
                gap: 6px;
                row-gap: 20px;
            }

            .collage-item {
                margin: -12px 0 0 -14px;
            }

            .booking-router__options {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 500px) {
            .collage-grid {
                grid-auto-rows: clamp(120px, 24vw, 160px);
                gap: 4px;
                row-gap: 16px;
                padding-bottom: 1rem;
            }

            .collage-item {
                margin: -10px 0 0 -10px;
            }

            .collage-review {
                padding: 0.8rem;
            }

            .collage-review p {
                font-size: 0.72rem;
            }

            .collage-review .reviewer {
                font-size: 0.65rem;
            }

            .booking-router {
                min-height: 620px;
            }

            .booking-router__top {
                grid-template-columns: 1fr;
            }

            .booking-router__body {
                min-height: 520px;
                align-content: start;
            }

            .booking-router__question {
                min-height: 4.4em;
            }

            .booking-router__option {
                min-height: 84px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .booking-router__bar,
            .booking-router__stage,
            .booking-router__option,
            .booking-router__option:hover,
            .booking-router__option.is-selected {
                animation: none;
                transition: none;
                transform: none;
            }

            .booking-router__cursor {
                display: none;
            }
        }
    </style>
