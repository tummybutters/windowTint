                        </div>
                    </div>
                `;

                const stage = body.querySelector('[data-router-stage]');
                const question = body.querySelector('[data-router-question]');
                const optionWrap = body.querySelector('[data-router-options]');
                const back = body.querySelector('[data-router-back]');
                const finish = body.querySelector('[data-router-finish]');

                window.requestAnimationFrame(() => stage.classList.remove('is-entering'));

                options.forEach((option) => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'booking-router__option';
                    button.dataset.value = option.value;
                    if (current.multi && state.addons.includes(option.value)) {
                        button.classList.add('is-selected');
                    }
                    button.innerHTML = `
                        <span class="booking-router__option-title">${option.label}</span>
                        <span class="booking-router__option-copy">${option.copy}</span>
                    `;
                    optionWrap.appendChild(button);
                });

                typeText(question, current.question, () => {
                    optionWrap.classList.add('is-ready');
                });

                optionWrap.addEventListener('click', (event) => {
                    const button = event.target.closest('.booking-router__option');
                    if (!button) return;

                    optionWrap.querySelectorAll('.booking-router__option').forEach((node) => node.classList.remove('is-selected'));
                    button.classList.add('is-selected');

                    const value = button.dataset.value;
                    const nextStep = current.next(value);
                    track('vip_quiz_answer', {
                        quiz_step: current.id,
                        answer: value,
                        ...getQuizPayload()
                    });

                    if (current.multi && nextStep === 'addons') {
                        optionWrap.querySelectorAll('.booking-router__option').forEach((node) => {
                            node.classList.toggle('is-selected', state.addons.includes(node.dataset.value));
                        });
                        return;
                    }

                    history.push(stepId);
                    track('vip_quiz_step_advance', {
                        from_step: current.id,
                        to_step: nextStep,
                        ...getQuizPayload()
                    });
                    window.setTimeout(() => render(nextStep), 180);
                });

                if (finish) {
                    finish.addEventListener('click', () => {
                        history.push(stepId);
                        track('vip_quiz_finish_click', getQuizPayload());
                        renderResult();
                    });
                }

                if (back) {
                    back.addEventListener('click', () => {
                        const previous = history.pop();
                        track('vip_quiz_back_click', {
                            from_step: current.id,
                            to_step: previous || '',
                            ...getQuizPayload()
                        });
                        if (previous) render(previous);
                    });
                }
            };

            const renderResult = () => {
                const service = resolveService();
                const addons = getAddonLabels();
                const canBookInSquare = service.mode === 'book' && squareBookingEnabled && service.bookingUrl;
                const needsConfirmation = service.mode === 'quote' || hasVariableAddon() || !canBookInSquare;
                count.textContent = 'Recommendation';
                bar.style.width = '100%';

                const notes = [
                    service.note,
                    addons.length ? `Selected add-ons: ${addons.join(', ')}.` : 'No add-ons selected.',
                    canBookInSquare ? 'Open Square and choose this package to lock the appointment.' : 'Call or text this setup and we will lock in the right appointment.'
                ];

                body.innerHTML = `
                    <div class="booking-router__stage is-entering" data-router-stage>
                        <div class="booking-router__summary">
                            <div class="booking-router__hint">Recommended package</div>
                            <div class="booking-router__summary-card">
                                <div class="booking-router__summary-label">${canBookInSquare ? 'Ready to book' : 'Ready to confirm'}</div>
                                <h3 class="booking-router__summary-title">${service.title}</h3>
                                <div class="booking-router__price-row">
                                    <div class="booking-router__price">${service.price}</div>
                                    <div class="booking-router__duration">${service.duration}</div>
                                </div>
                                <div class="booking-router__notes">
                                    ${notes.map((note) => `<p>${note}</p>`).join('')}
                                </div>
                            </div>
                            <div class="booking-router__cta-row">
                                ${canBookInSquare
                                    ? `<a class="brutalist-btn brutalist-btn--primary" href="${service.bookingUrl || squareBookingUrl}" data-router-book>Open Square Booking</a>`
                                    : service.mode === 'book'
                                        ? `<a class="brutalist-btn brutalist-btn--primary" href="tel:7146007134">Call To Book This</a>
                                           <a class="brutalist-btn brutalist-btn--outline" href="${buildTextHref(service)}" data-router-text>Text This Setup</a>`
                                    : `<a class="brutalist-btn brutalist-btn--primary" href="${buildTextHref(service)}" data-router-text>Text This Setup</a>`}
                                ${canBookInSquare && needsConfirmation
                                    ? `<a class="brutalist-btn brutalist-btn--outline" href="${buildTextHref(service)}" data-router-text>Text Add-ons</a>`
                                    : ''}
                                ${service.mode === 'quote'
                                    ? `<a class="brutalist-btn brutalist-btn--outline" href="tel:7146007134">Call ${phoneDisplay}</a>`
                                    : ''}
                                <button class="booking-router__back" type="button" data-router-restart>Start Over</button>
                            </div>
                            <p class="booking-router__fineprint">${canBookInSquare ? 'Square will handle the appointment time and deposit.' : 'Your selected package is included when you call or text, so Kislev can lock the right service without guessing.'} If your setup includes removal, mobile priority, same-day timing, chrome delete, or residential window film, confirm with Kislev before locking the slot.</p>
                        </div>
                    </div>
                `;

                window.requestAnimationFrame(() => {
                    const stage = body.querySelector('[data-router-stage]');
                    if (stage) stage.classList.remove('is-entering');
                    maybeDecorateLinks();
                });

                track('vip_quiz_recommendation', {
                    needs_confirmation: needsConfirmation ? 'yes' : 'no',
                    ...getQuizPayload(service)
                });

                const bookLink = body.querySelector('[data-router-book]');
                if (bookLink) {
                    bookLink.addEventListener('click', () => {
                        track('vip_quiz_square_click', {
                            link_url: bookLink.href,
                            needs_confirmation: needsConfirmation ? 'yes' : 'no',
                            ...getQuizPayload(service)
                        });
                    });
                }

                const textLink = body.querySelector('[data-router-text]');
                if (textLink) {
                    textLink.addEventListener('click', () => {
                        track('vip_quiz_text_click', {
                            link_url: textLink.href,
                            needs_confirmation: needsConfirmation ? 'yes' : 'no',
                            ...getQuizPayload(service)
                        });
                    });
                }

                const callLink = body.querySelector('a[href^="tel:"]');
                if (callLink) {
                    callLink.addEventListener('click', () => {
                        track('vip_quiz_call_click', {
                            link_url: callLink.href,
                            needs_confirmation: needsConfirmation ? 'yes' : 'no',
                            ...getQuizPayload(service)
                        });
                    });
                }

                const restart = body.querySelector('[data-router-restart]');
                if (restart) {
                    restart.addEventListener('click', () => {
                        track('vip_quiz_restart_click', getQuizPayload(service));
                        state.vehicle = '';
                        state.teslaModel = '';
                        state.coverage = '';
                        state.addons = [];
                        history.splice(0, history.length);
                        render('vehicle');
                    });
                }
            };

            render('vehicle');
        })();
    </script>
    <script src="/lead-tracking.js" defer></script>
</body>

</html>
